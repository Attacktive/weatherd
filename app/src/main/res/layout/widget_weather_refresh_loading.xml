<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/weather_refresh_widget_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:accessibilityLiveRegion="polite"
	android:clickable="true"
	android:contentDescription="@string/refresh_now"
	android:focusable="true"
	android:foreground="@drawable/widget_refresh_feedback"
	android:importantForAccessibility="yes"
	android:padding="4dp"
>
	<FrameLayout
		android:id="@+id/weather_refresh_widget_status"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_gravity="center"
		android:background="@drawable/widget_refresh_status_background"
		android:clickable="false"
		android:elevation="4dp"
		android:focusable="false"
		android:importantForAccessibility="no"
	>
		<ViewFlipper
			android:id="@+id/weather_refresh_widget_progress"
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:layout_gravity="center"
			android:autoStart="true"
			android:flipInterval="125"
		>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="0"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="45"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="90"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="135"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="180"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="225"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="270"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
			<ImageView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:importantForAccessibility="no"
				android:rotation="315"
				android:src="@drawable/widget_refresh_spinner_frame"
			/>
		</ViewFlipper>
	</FrameLayout>
</FrameLayout>
