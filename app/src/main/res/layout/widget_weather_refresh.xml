<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/weather_refresh_widget_container"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:accessibilityLiveRegion="polite"
	android:clickable="true"
	android:contentDescription="@string/refresh_now"
	android:focusable="true"
	android:foreground="@drawable/widget_refresh_feedback"
	android:importantForAccessibility="yes"
	android:padding="4dp"
>
	<FrameLayout
		android:id="@+id/weather_refresh_widget"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_gravity="center"
		android:background="@drawable/widget_refresh_background"
		android:clickable="false"
		android:elevation="4dp"
		android:focusable="false"
		android:importantForAccessibility="no"
	/>

	<FrameLayout
		android:id="@+id/weather_refresh_widget_status"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_gravity="center"
		android:background="@drawable/widget_refresh_status_background"
		android:clickable="false"
		android:elevation="4dp"
		android:focusable="false"
		android:importantForAccessibility="no"
		android:visibility="gone"
	>
		<TextView
			android:id="@+id/weather_refresh_widget_result"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fontFamily="sans-serif-medium"
			android:gravity="center"
			android:includeFontPadding="false"
			android:textColor="@android:color/white"
			android:textSize="30sp"
		/>
	</FrameLayout>
</FrameLayout>
